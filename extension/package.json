{
  "name": "westielens-extension",
  "description": "WestieLens 西高地伴读：英文划词翻译、句子结构与语法分析、音标与朗读",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/xinkaic83-dev/WestieLens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinkaic83-dev/WestieLens.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/xinkaic83-dev/WestieLens/issues"
  }
}
